{
  "name": "server",
  "version": "0.0.0-dev",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/backend.bin",
    "check": "tsgo",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "shared": "workspace:*",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "@azure/msal-node": "~5.2.5",
    "otplib": "~13.4.1",
    "valibot": "~1.4.1"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
