{
  "name": "server",
  "version": "0.0.0-dev",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/backend.bin",
    "typecheck": "bun check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "shared": "workspace:*",
    "better-result": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "@hono/valibot-validator": "catalog:",
    "@azure/msal-node": "~7.1.2",
    "otplib": "~13.5.0",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  }
}
