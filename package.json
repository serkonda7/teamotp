    "solid-js": "~1.9.13"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.15",
    "@types/bun": "~1.3.14",
    "@types/node": "~24.12.4",
    "@typescript/native-preview": "~7.0.0-dev.20260511.1",
