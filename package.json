{
  "name": "teamotp",
  "description": "",
  "version": "0.0.4",
  "license": "MPL-2.0",
  "author": "Lukas Neubert (serkonda7)",
  "homepage": "https://github.com/serkonda7/teamotp",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/teamotp"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/teamotp/issues"
  },
  "workspaces": [
    "server",
    "server-cli",
    "client",
    "shared",
    "infra"
  ],
  "scripts": {
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "turbo run check",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "bun run --cwd server db:generate",
    "test": "turbo run test",
    "test:coverage": "bun test server/src client/src --coverage --coverage-reporter=lcov",
    "test:smoke": "bun test tests/smoke --timeout 20000",
    "test:e2e": "playwright test"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "drizzle-kit": "~0.31.10",
    "drizzle-orm": "~0.45.2",
    "hono": "~4.12.23",
    "better-result": "~2.9.2"
  },
  "devDependencies": {
    "@playwright/test": "~1.60.0",
    "@biomejs/biome": "~2.4.16",
    "@types/bun": "~1.3.14",
    "@types/node": "~24.12.4",
    "@typescript/native-preview": "~7.0.0-dev.20260601.1",
    "turbo": "~2.9.16"
  }
}
