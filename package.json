{
  "name": "teamotp",
  "description": "",
  "version": "0.4.0",
  "license": "MPL-2.0",
  "author": "Lukas Neubert (serkonda7)",
  "homepage": "https://github.com/serkonda7/teamotp",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/teamotp"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/teamotp/issues"
  },
  "workspaces": [
    "server",
    "server-cli",
    "client",
    "shared",
    "infra"
  ],
  "scripts": {
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "turbo run check",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "bun run --cwd server db:generate",
    "test": "turbo run test",
    "test:smoke": "bun test tests/smoke --timeout 20000",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-desktop --project=visual-narrow --no-deps"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "drizzle-kit": "~0.31.10",
    "drizzle-orm": "~0.45.2",
    "hono": "~4.13.5",
    "@hono/valibot-validator": "~0.6.1",
    "better-result": "~3.0.1",
    "valibot": "~1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.1",
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "@types/node": "~26.4.0",
    "typescript": "~7.0.2",
    "turbo": "~2.10.12"
  }
}
