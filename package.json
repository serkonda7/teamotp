  "homepage": "https://github.com/serkonda7/teamotp",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/teamotp"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/teamotp/issues"
  },
  "workspaces": [
    "server",
    "server-cli",
    "client",
    "shared",
    "infra"
  ],
  "scripts": {
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "turbo run check",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "bun run --cwd server db:generate",
    "test": "turbo run test",
    "test:smoke": "bun test tests/smoke --timeout 20000",
    "test:e2e": "playwright test"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "drizzle-kit": "~0.31.10",
    "drizzle-orm": "~0.45.2",
    "hono": "~4.12.30",
    "better-result": "~2.9.2"
  },
  "devDependencies": {
    "@playwright/test": "~1.61.1",
    "@biomejs/biome": "~2.5.3",
    "@types/bun": "~1.3.14",
    "@types/node": "~26.1.1",
    "typescript": "~7.0.0",
    "turbo": "~2.10.4"
  }
}
